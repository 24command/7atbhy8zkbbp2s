- (CGFloat)x:(double)value{return self.bounds.size.width*((self.whiteUi?.15:.34)+(self.whiteUi?.70:.55)*MAX(0,MIN(1,value/self.duration)));}
- (void)parameter:(NSString*)name value:(double)value left:(CGFloat)left right:(CGFloat)right y:(CGFloat)y color:(unsigned)color{CGFloat scale=self.bounds.size.height/600;[self text:name x:left y:y-9*scale size:10 color:color align:0];[self text:[NSString stringWithFormat:@"%.2f×",value] x:right y:y-9*scale size:10 color:0xffffffff align:2];[self line:left y:y to:right y:y width:2 color:0x70ffffff];CGFloat x=left+(right-left)*MAX(0,MIN(1,value/5));[self line:left y:y to:x y:y width:2 color:color];[PCColor(color)setFill];[[UIBezierPath bezierPathWithOvalInRect:CGRectMake(x-4*scale,y-4*scale,8*scale,8*scale)]fill];}
