 }else{CGRect panel=CGRectMake(w*.07,h*.575,w*.86,h*.37);CGFloat cut=panel.size.height*.267949;UIBezierPath*path=[UIBezierPath bezierPath];[path moveToPoint:CGPointMake(panel.origin.x+cut,panel.origin.y)];[path addLineToPoint:CGPointMake(CGRectGetMaxX(panel),panel.origin.y)];[path addLineToPoint:CGPointMake(CGRectGetMaxX(panel)-cut,CGRectGetMaxY(panel))];[path addLineToPoint:CGPointMake(panel.origin.x,CGRectGetMaxY(panel))];[path closePath];[PCColor(0xeb111519)setFill];[path fill];[PCColor(0x606e737a)setStroke];path.lineWidth=k;[path stroke];CGContextSaveGState(UIGraphicsGetCurrentContext());[path addClip];for(CGFloat x=w*.07;x<w*.93;x+=MAX(22*k,w*.035))[self line:x y:h*.575 to:x y:h*.945 width:.7 color:0x182f3940];for(CGFloat y=h*.575;y<h*.945;y+=MAX(22*k,w*.035))[self line:w*.07 y:y to:w*.93 y:y width:.7 color:0x182f3940];CGContextRestoreGState(UIGraphicsGetCurrentContext());[self text:@"PHI / PRACTICE" x:w*.134 y:h*.61 size:9 color:0xffa7adb5 align:0];[self text:[self.state[@"ended"]boolValue]?@"COMPLETE":@"PAUSED" x:w*.89 y:h*.61 size:9 color:0xffffeca4 align:2];[self polygon:CGRectMake(w*.66,h*.585,w*.14,h*.032) color:0xff293037];[self text:@"切换 UI" x:w*.73 y:h*.609 size:11 color:0xffffffff align:1];[self text:@"当前" x:w*.12 y:h*.69 size:11 color:0xffffeca4 align:0];[self text:[self clockText:self.current] x:w*.13 y:h*.752 size:27 color:0xffffffff align:0];[self text:self.errorText ?: ([self.state[@"ended"]boolValue]?@"本段练习结束 · 成绩未保存":@"拖动当前查看谱面") x:w*.13 y:h*.807 size:10 color:0xffa7adb5 align:0];[self line:w*.305 y:h*.655 to:w*.305 y:h*.925 width:1 color:0x606e737a];[self polygon:CGRectMake(w*.34,h*.725-3*k,w*.55,6*k) color:0xff4b5056];[self polygon:CGRectMake([self x:self.start],h*.725-3*k,MAX(1,[self x:self.end]-[self x:self.start]),6*k) color:0xffd8dde0];for(int i=0;i<=40;++i){CGFloat x=w*(.34+.55*i/40);[self line:x y:h*.725+11*k to:x y:h*.725+(i%5==0?19:15)*k width:1 color:i%5==0?0x99ffffff:0x407d838a];}double values[]={self.start,self.end,self.current};unsigned colors3[]={0xffe6e8eb,0xffe6e8eb,0xffffeca4};CGFloat ys[]={h*.725-27*k,h*.725+27*k,h*.725};for(int i=0;i<3;++i){CGFloat x=[self x:values[i]];[self line:x y:h*.725 to:x y:ys[i] width:1 color:colors3[i]];[self polygon:CGRectMake(x-6*k,ys[i]-7*k,12*k,14*k) color:colors3[i]];}[self text:[self clockText:0] x:w*.34 y:h*.625 size:9 color:0xff949ca5 align:0];[self text:[self clockText:self.duration] x:w*.89 y:h*.625 size:9 color:0xff949ca5 align:2];[self polygon:CGRectMake(w*.34,h*.852,w*.24,h*.053) color:0xff22272d];[self polygon:CGRectMake(w*.63,h*.852,w*.23,h*.053) color:0xff22272d];[self text:@"01  开始时间" x:w*.355 y:h*.887 size:10 color:0xffe6e8eb align:0];[self text:[self clockText:self.start] x:w*.56 y:h*.888 size:12 color:0xffffffff align:2];[self text:@"02  结束时间" x:w*.645 y:h*.887 size:10 color:0xffe6e8eb align:0];[self text:[self clockText:self.end] x:w*.835 y:h*.888 size:12 color:0xffffffff align:2];[self parameter:@"倍速" value:self.rate left:w*.13 right:w*.278 y:h*.86 color:0xffffffff];[self parameter:@"流速" value:self.flow left:w*.13 right:w*.278 y:h*.915 color:0xffb8dfe8];}
