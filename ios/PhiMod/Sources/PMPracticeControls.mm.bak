- (void)text:(NSString*)value x:(CGFloat)x y:(CGFloat)y size:(CGFloat)size color:(unsigned)color align:(NSInteger)align{CGFloat scale=self.bounds.size.height/600;UIFont*f=[UIFont monospacedDigitSystemFontOfSize:MAX(8,size*scale) weight:UIFontWeightMedium];NSDictionary*a=@{NSFontAttributeName:f,NSForegroundColorAttributeName:PCColor(color)};CGSize s=[value sizeWithAttributes:a];[value drawAtPoint:CGPointMake(x-(align==1?s.width/2:align==2?s.width:0),y-s.height*.8) withAttributes:a];}
- (void)line:(CGFloat)x y:(CGFloat)y to:(CGFloat)x2 y:(CGFloat)y2 width:(CGFloat)width color:(unsigned)color{UIBezierPath*p=[UIBezierPath bezierPath];[p moveToPoint:CGPointMake(x,y)];[p addLineToPoint:CGPointMake(x2,y2)];p.lineWidth=MAX(1,width*self.bounds.size.height/600);[PCColor(color)setStroke];[p stroke];}
