#import "PMContentStore.h"
#import "PMChartConvert.h"
#import "PMArchive.h"
#import <UIKit/UIKit.h>
#import <AVFoundation/AVFoundation.h>
#import <CommonCrypto/CommonDigest.h>
#include <algorithm>
#include <cmath>
#include <cstdio>
#define STB_VORBIS_HEADER_ONLY
#include "../Vendor/stb/stb_vorbis.c"
namespace {
NSError*err(NSString*s){return [NSError errorWithDomain:@"PhiMod.Library" code:1 userInfo:@{NSLocalizedDescriptionKey:s ?: @"操作失败"}];}
id clone(id x){NSData*d=[NSJSONSerialization dataWithJSONObject:x options:0 error:nil];return d?[NSJSONSerialization JSONObjectWithData:d options:NSJSONReadingMutableContainers error:nil]:nil;}
BOOL writeJSON(id x,NSString*p,NSError**e){NSData*d=[NSJSONSerialization dataWithJSONObject:x options:NSJSONWritingPrettyPrinted error:e];return d&&[d writeToFile:p options:NSDataWritingAtomic error:e];}
NSString*fresh(){return [@"pm_" stringByAppendingString:[[NSUUID.UUID.UUIDString stringByReplacingOccurrencesOfString:@"-" withString:@""] lowercaseString]];}
BOOL safeID(NSString*x){if(![x isKindOfClass:NSString.class]||![x hasPrefix:@"pm_"]||x.length>80)return NO;return [x rangeOfCharacterFromSet:[[NSCharacterSet characterSetWithCharactersInString:@"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"] invertedSet]].location==NSNotFound;}
NSString*text(NSString*p){return [[NSString stringWithContentsOfFile:p encoding:NSUTF8StringEncoding error:nil]stringByReplacingOccurrencesOfString:@"\ufeff" withString:@""] ?: @"";}
NSArray*csv(NSString*s){NSMutableArray*rows=[NSMutableArray new],*row=[NSMutableArray new];NSMutableString*value=[NSMutableString new];BOOL quoted=NO;for(NSUInteger i=0;i<s.length;++i){unichar c=[s characterAtIndex:i];if(c=='"'){if(quoted&&i+1<s.length&&[s characterAtIndex:i+1]=='"'){[value appendString:@"\""];++i;}else quoted=!quoted;}else if(c==','&&!quoted){[row addObject:[value copy]];[value setString:@""];}else if((c=='\n'||c=='\r')&&!quoted){if(c=='\r'&&i+1<s.length&&[s characterAtIndex:i+1]=='\n')++i;[row addObject:[value copy]];[rows addObject:row];row=[NSMutableArray new];[value setString:@""];}else[value appendFormat:@"%C",c];}if(value.length||row.count){[row addObject:value];[rows addObject:row];}return rows;}
NSString*locate(NSArray*files,NSString*name,NSArray*extensions,BOOL optional,NSError**e){NSMutableArray*candidates=[NSMutableArray new];for(NSString*p in files)if([extensions containsObject:p.pathExtension.lowercaseString]){if([@[@"info.json",@"extra.json",@"chapter.json",@"metadata.json"] containsObject:p.lastPathComponent.lowercaseString])continue;[candidates addObject:p];if(name.length&&[p.lastPathComponent caseInsensitiveCompare:name.lastPathComponent]==NSOrderedSame)return p;}if(candidates.count==1)return candidates[0];if(!candidates.count&&optional)return nil;if(e)*e=err(candidates.count?@"谱包含多个候选文件，请在 info.yml/info.csv 中指定路径":@"谱包缺少谱面或音乐");return nil;}
NSString*digest(NSString*p){NSFileHandle*h=[NSFileHandle fileHandleForReadingAtPath:p];if(!h)return nil;CC_SHA256_CTX c;CC_SHA256_Init(&c);for(;;){NSData*d=[h readDataOfLength:262144];if(!d.length)break;CC_SHA256_Update(&c,d.bytes,(CC_LONG)d.length);}[h closeFile];unsigned char out[CC_SHA256_DIGEST_LENGTH];CC_SHA256_Final(out,&c);NSMutableString*s=[NSMutableString new];for(int i=0;i<CC_SHA256_DIGEST_LENGTH;++i)[s appendFormat:@"%02x",out[i]];return s;}
BOOL audio(NSString*source,NSString*destination,NSError**error){
 NSURL*url=[NSURL fileURLWithPath:source];AVAudioFile*input=[[AVAudioFile alloc]initForReading:url error:error];
 if(input){AVAudioFormat*format=input.processingFormat;AVAudioFile*out=[[AVAudioFile alloc]initForWriting:[NSURL fileURLWithPath:destination] settings:format.settings commonFormat:format.commonFormat interleaved:format.interleaved error:error];if(!out)return NO;AVAudioPCMBuffer*buffer=[[AVAudioPCMBuffer alloc]initWithPCMFormat:format frameCapacity:65536];while(input.framePosition<input.length){if(![input readIntoBuffer:buffer frameCount:65536 error:error]||![out writeFromBuffer:buffer error:error])return NO;}return YES;}
 if(![source.pathExtension.lowercaseString isEqualToString:@"ogg"])return NO;if(error)*error=nil;
 int code=0;stb_vorbis*v=stb_vorbis_open_filename(source.fileSystemRepresentation,&code,nullptr);if(!v){if(error)*error=err(@"音乐解码失败（支持 WAV/MP3/M4A/FLAC/Ogg Vorbis）");return NO;}stb_vorbis_info info=stb_vorbis_get_info(v);if(info.channels<1||info.channels>8||info.sample_rate>192000){stb_vorbis_close(v);if(error)*error=err(@"音频声道或采样率不支持");return NO;}
 AVAudioFormat*format=[[AVAudioFormat alloc]initStandardFormatWithSampleRate:info.sample_rate channels:info.channels];AVAudioFile*out=[[AVAudioFile alloc]initForWriting:[NSURL fileURLWithPath:destination] settings:format.settings commonFormat:AVAudioPCMFormatFloat32 interleaved:NO error:error];if(!out){stb_vorbis_close(v);return NO;}AVAudioPCMBuffer*b=[[AVAudioPCMBuffer alloc]initWithPCMFormat:format frameCapacity:65536];BOOL ok=YES;for(;;){float **planes=(float **)(void*)b.floatChannelData;int n=stb_vorbis_get_samples_float(v,info.channels,planes,65536);if(n<=0)break;b.frameLength=n;if(![out writeFromBuffer:b error:error]){ok=NO;break;}}stb_vorbis_close(v);return ok;
}
}
@interface PMContentStore ()
@property(nonatomic,copy,readwrite) NSString*root;
@property(nonatomic,readwrite) NSUInteger revision;
@property(nonatomic,strong) NSMutableDictionary*db;
@end
@implementation PMContentStore
+ (instancetype)shared{static PMContentStore*s;static dispatch_once_t once;dispatch_once(&once,^{s=[PMContentStore new];});return s;}
- (instancetype)init{if((self=[super init])){self.root=[NSSearchPathForDirectoriesInDomains(NSDocumentDirectory,NSUserDomainMask,YES).firstObject stringByAppendingPathComponent:@"PhiMod"];NSFileManager*f=NSFileManager.defaultManager;for(NSString*name in @[@"assets",@"imports",@"exports",@"trash"])[f createDirectoryAtPath:[self.root stringByAppendingPathComponent:name] withIntermediateDirectories:YES attributes:nil error:nil];NSData*d=[NSData dataWithContentsOfFile:[self.root stringByAppendingPathComponent:@"library.json"]];self.db=d?[NSJSONSerialization JSONObjectWithData:d options:NSJSONReadingMutableContainers error:nil]:nil;if(!self.db){NSData*backup=[NSData dataWithContentsOfFile:[self.root stringByAppendingPathComponent:@"library.backup.json"]];self.db=backup?[NSJSONSerialization JSONObjectWithData:backup options:NSJSONReadingMutableContainers error:nil]:nil;}if(!self.db)self.db=[@{@"songs":[NSMutableArray new],@"chapters":[@[[ @{@"id":@"pm_local",@"name":@"自制谱收藏",@"subtitle":@"LOCAL CHARTS",@"songs":@[]} mutableCopy]] mutableCopy],@"overrides":[NSMutableDictionary new],@"hiddenChapters":[NSMutableArray new],@"chartSelections":[NSMutableDictionary new]} mutableCopy];self.revision=1;}return self;}
- (NSDictionary*)snapshot{@synchronized(self){return clone(self.db);}}
- (NSString*)asset:(NSString*)identifier{return safeID(identifier)?[[self.root stringByAppendingPathComponent:@"assets"]stringByAppendingPathComponent:identifier]:nil;}
- (BOOL)commit:(NSDictionary*)value error:(NSError**)error{@synchronized(self){if(![value[@"songs"] isKindOfClass:NSArray.class]||![value[@"chapters"] isKindOfClass:NSArray.class]){if(error)*error=err(@"曲库结构无效");return NO;}NSMutableSet*ids=[NSMutableSet new];for(NSDictionary*s in value[@"songs"]){NSString*i=s[@"id"];if(!safeID(i)||[ids containsObject:i]){if(error)*error=err(@"谱面 ID 重复或不合法");return NO;}[ids addObject:i];}NSMutableSet*chapterIDs=[NSMutableSet new];for(NSDictionary*c in value[@"chapters"]){if(!safeID(c[@"id"])||[chapterIDs containsObject:c[@"id"]]||![c[@"name"] length]){if(error)*error=err(@"章节 ID 或名称无效");return NO;}[chapterIDs addObject:c[@"id"]];}NSString*p=[self.root stringByAppendingPathComponent:@"library.json"];if([NSFileManager.defaultManager fileExistsAtPath:p]&&![[NSData dataWithContentsOfFile:p] writeToFile:[self.root stringByAppendingPathComponent:@"library.backup.json"] options:NSDataWritingAtomic error:error])return NO;if(!writeJSON(value,p,error))return NO;self.db=clone(value);self.revision++;return YES;}}
- (BOOL)replaceImage:(NSURL*)url identifier:(NSString*)identifier error:(NSError**)error{NSData*data=[NSData dataWithContentsOfURL:url];if(!data){if(error)*error=err(@"Unable to read image data.");return NO;}return [self replaceImageData:data identifier:identifier error:error];}
- (BOOL)replaceImageData:(NSData*)data identifier:(NSString*)identifier error:(NSError**)error{NSString*folder=[self asset:identifier];if(!folder){if(error)*error=err(@"Invalid asset ID");return NO;}UIImage*image=[UIImage imageWithData:data];if(!image||!image.CGImage){if(error)*error=err(@"Unable to read image");return NO;}CGFloat sourceW=image.size.width*image.scale,sourceH=image.size.height*image.scale;if(sourceW<=0||sourceH<=0){if(error)*error=err(@"Unable to read image");return NO;}CGFloat factor=MIN(1.0,2048.0/MAX(sourceW,sourceH));CGSize size=CGSizeMake(MAX(1,round(sourceW*factor)),MAX(1,round(sourceH*factor)));UIGraphicsImageRendererFormat*format=[UIGraphicsImageRendererFormat defaultFormat];format.scale=1;UIGraphicsImageRenderer*r=[[UIGraphicsImageRenderer alloc]initWithSize:size format:format];NSData*png=UIImagePNGRepresentation([r imageWithActions:^(UIGraphicsImageRendererContext*c){[image drawInRect:CGRectMake(0,0,size.width,size.height)];}]);if(!png){if(error)*error=err(@"Unable to read image");return NO;}[NSFileManager.defaultManager createDirectoryAtPath:folder withIntermediateDirectories:YES attributes:nil error:error];BOOL ok=[png writeToFile:[folder stringByAppendingPathComponent:@"image.png"] options:NSDataWritingAtomic error:error];if(ok)@synchronized(self){self.revision++;}return ok;}
- (BOOL)importURL:(NSURL*)url chapter:(NSString*)chapter error:(NSError**)error{
 NSFileManager*f=NSFileManager.defaultManager;NSString*stage=[[self.root stringByAppendingPathComponent:@"imports"]stringByAppendingPathComponent:NSUUID.UUID.UUIDString];if(![f createDirectoryAtPath:stage withIntermediateDirectories:YES attributes:nil error:error])return NO;BOOL access=[url startAccessingSecurityScopedResource];BOOL ok=NO;NSMutableArray*moved=[NSMutableArray new];
 @try{try{NSFileCoordinator*coordinator=[[NSFileCoordinator alloc]initWithFilePresenter:nil];__block NSArray*files=nil;__block NSError*readError=nil;[coordinator coordinateReadingItemAtURL:url options:0 error:&readError byAccessor:^(NSURL*readURL){files=PMExtractArchive(readURL.path,stage,&readError);}];if(!files){if(error)*error=readError;return NO;}
 NSString*manifestPath=nil;for(NSString*p in files)if([p.lastPathComponent isEqualToString:@"chapter.json"])manifestPath=p;
 if(manifestPath){NSDictionary*manifest=[NSJSONSerialization JSONObjectWithData:[NSData dataWithContentsOfFile:manifestPath] options:NSJSONReadingMutableContainers error:error];if(![manifest[@"format"] isEqualToString:@"phigros-phi-chapter"]||[manifest[@"version"] intValue]!=1){if(error)*error=err(@"章节包格式不支持");return NO;}NSMutableDictionary*db=clone([self snapshot]);NSMutableDictionary*map=[NSMutableDictionary new];NSString*chapterID=fresh();NSArray*songs=manifest[@"songs"];if(![songs isKindOfClass:NSArray.class]||songs.count>2000){if(error)*error=err(@"章节包谱面数量无效");return NO;}
 NSDictionary*inventory=manifest[@"files"];for(NSString*name in inventory){NSString*p=[[manifestPath.stringByDeletingLastPathComponent stringByAppendingPathComponent:name]stringByStandardizingPath];if(![p hasPrefix:[stage stringByAppendingString:@"/"]]||![f fileExistsAtPath:p]||![[digest(p) lowercaseString] isEqualToString:[inventory[name][@"sha256"] lowercaseString]]){if(error)*error=err(@"章节包资源校验失败");return NO;}}
 for(NSDictionary*s in songs){NSString*original=s[@"id"];if(!safeID(original)||map[original]){if(error)*error=err(@"章节包谱面编号无效");return NO;}map[original]=fresh();}
 for(NSDictionary*s in songs){NSMutableDictionary*song=clone(s);NSString*original=s[@"id"],*identifier=map[original];NSString*folder=[[manifestPath.stringByDeletingLastPathComponent stringByAppendingPathComponent:@"songs"]stringByAppendingPathComponent:original];NSData*chartData=[NSData dataWithContentsOfFile:[folder stringByAppendingPathComponent:@"source.rpe.json"]] ?: [NSData dataWithContentsOfFile:[folder stringByAppendingPathComponent:@"chart.json"]];NSDictionary*c=chartData?PMConvertChart(chartData,error):nil;if(!c)return NO;if(!writeJSON(c,[folder stringByAppendingPathComponent:@"chart.json"],error)||!writeJSON(PMNativeChart(c),[folder stringByAppendingPathComponent:@"chart-native.json"],error))return NO;
 if(![f fileExistsAtPath:[folder stringByAppendingPathComponent:@"music.caf"]]){NSArray*resources=[f subpathsOfDirectoryAtPath:folder error:nil];NSMutableArray*full=[NSMutableArray new];for(NSString*p in resources)[full addObject:[folder stringByAppendingPathComponent:p]];NSString*music=locate(full,nil,@[@"ogg",@"mp3",@"wav",@"m4a",@"flac",@"caf"],NO,error);if(!music||!audio(music,[folder stringByAppendingPathComponent:@"music.caf"],error))return NO;}
 NSString*destination=[self asset:identifier];if(![f moveItemAtPath:folder toPath:destination error:error])return NO;[moved addObject:destination];song[@"id"]=identifier;song[@"groupId"]=map[song[@"groupId"]] ?: identifier;song[@"targetChapter"]=chapterID;song[@"beforeSong"]=map[song[@"beforeSong"]] ?: @"";[db[@"songs"] addObject:song];}
 NSMutableDictionary*c=clone(manifest[@"chapter"]);c[@"id"]=chapterID;NSMutableArray*order=[NSMutableArray new];for(NSString*i in manifest[@"chapter"][@"songs"])if(map[i])[order addObject:map[i]];for(NSString*i in map)if(![order containsObject:map[i]])[order addObject:map[i]];c[@"songs"]=order;c[@"before"]=@"";[c removeObjectForKey:@"unlock"];[db[@"chapters"] addObject:c];NSString*cover=[manifestPath.stringByDeletingLastPathComponent stringByAppendingPathComponent:@"chapter/image.png"];if([f fileExistsAtPath:cover]){[f createDirectoryAtPath:[self asset:chapterID] withIntermediateDirectories:YES attributes:nil error:nil];if(![f copyItemAtPath:cover toPath:[[self asset:chapterID]stringByAppendingPathComponent:@"image.png"] error:error])return NO;[moved addObject:[self asset:chapterID]];}ok=[self commit:db error:error];return ok;}
 NSMutableDictionary*meta=[NSMutableDictionary new];for(NSString*p in files){NSString*name=p.lastPathComponent.lowercaseString;if([@[@"info.yml",@"info.yaml",@"info.txt"] containsObject:name]){for(NSString*line in [text(p) componentsSeparatedByCharactersInSet:NSCharacterSet.newlineCharacterSet]){NSRange colon=[line rangeOfString:@":"];if(colon.location==NSNotFound)continue;NSString*k=[[line substringToIndex:colon.location]stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceCharacterSet].lowercaseString;NSString*v=[[line substringFromIndex:colon.location+1]stringByTrimmingCharactersInSet:[NSCharacterSet characterSetWithCharactersInString:@" \"'"]];meta[k]=v;}}else if([name isEqualToString:@"info.csv"]){NSArray*rows=csv(text(p));if(rows.count>2){if(error)*error=err(@"此谱包 info.csv 包含多张谱面；请分别导入各谱包，避免误选谱面");return NO;}if(rows.count>1){NSArray*headers=rows[0],*values=rows[1];for(NSUInteger i=0;i<MIN(headers.count,values.count);++i)meta[[headers[i] lowercaseString]]=values[i];}}else if([name isEqualToString:@"info.json"]){id value=[NSJSONSerialization JSONObjectWithData:[NSData dataWithContentsOfFile:p] options:0 error:nil];if([value isKindOfClass:NSDictionary.class])for(NSString*k in value)meta[k.lowercaseString]=value[k];}}
 NSString*chart=locate(files,meta[@"chart"],@[@"json",@"pec"],NO,error),*music=locate(files,meta[@"song"] ?: meta[@"music"],@[@"ogg",@"mp3",@"wav",@"flac",@"m4a",@"caf"],NO,error),*image=locate(files,meta[@"picture"] ?: meta[@"illustration"],@[@"png",@"jpg",@"jpeg",@"webp"],YES,error);if(!chart||!music||(error&&*error))return NO;NSDictionary*converted=PMConvertChart([NSData dataWithContentsOfFile:chart],error);if(!converted)return NO;NSString*identifier=fresh(),*destination=[self asset:identifier];if(![f createDirectoryAtPath:destination withIntermediateDirectories:YES attributes:nil error:error])return NO;[moved addObject:destination];for(NSString*p in files){NSString*relative=[p substringFromIndex:stage.length+1];NSString*dest=[destination stringByAppendingPathComponent:relative];[f createDirectoryAtPath:dest.stringByDeletingLastPathComponent withIntermediateDirectories:YES attributes:nil error:nil];if(![f copyItemAtPath:p toPath:dest error:error])return NO;}
 if([converted[@"pmFormat"] isEqualToString:@"RPE"]&&![[NSData dataWithContentsOfFile:chart]writeToFile:[destination stringByAppendingPathComponent:@"source.rpe.json"] options:NSDataWritingAtomic error:error])return NO;
 if(!writeJSON(converted,[destination stringByAppendingPathComponent:@"chart.json"],error)||!writeJSON(PMNativeChart(converted),[destination stringByAppendingPathComponent:@"chart-native.json"],error)||!audio(music,[destination stringByAppendingPathComponent:@"music.caf"],error))return NO;if(image&&![self replaceImage:[NSURL fileURLWithPath:image] identifier:identifier error:error])return NO;
 NSMutableDictionary*db=clone([self snapshot]);NSString*target=chapter.length?chapter:@"pm_local";NSMutableDictionary*found=nil;for(NSMutableDictionary*c in db[@"chapters"])if([c[@"id"] isEqualToString:target])found=c;if(!found){if(error)*error=err(@"目标章节不存在");return NO;}NSString*level=[meta[@"level"] isKindOfClass:NSString.class]?meta[@"level"]:@"IN";double difficulty=0;NSScanner*scanner=[NSScanner scannerWithString:level];for(NSUInteger i=0;i<level.length;++i)if([[NSCharacterSet decimalDigitCharacterSet] characterIsMember:[level characterAtIndex:i]]){scanner.scanLocation=i;[scanner scanDouble:&difficulty];break;}NSString*slot=@"IN";for(NSString*s in @[@"EZ",@"HD",@"IN",@"AT"])if([level.uppercaseString containsString:s])slot=s;
 NSMutableDictionary*song=[@{@"id":identifier,@"groupId":identifier,@"title":meta[@"name"] ?: meta[@"title"] ?: chart.lastPathComponent.stringByDeletingPathExtension,@"composer":meta[@"composer"] ?: meta[@"artist"] ?: @"",@"charter":meta[@"charter"] ?: meta[@"designer"] ?: @"",@"illustrator":meta[@"illustrator"] ?: @"",@"level":slot,@"difficulty":@(difficulty),@"difficultyLabel":slot,@"preview":@0,@"previewEnd":@15,@"offsetMs":@0,@"targetChapter":target,@"sourceFormat":converted[@"pmFormat"] ?: @"Phigros v3",@"resourceRoot":[chart.stringByDeletingLastPathComponent isEqualToString:stage]?@"":[chart.stringByDeletingLastPathComponent substringFromIndex:stage.length+1],@"sourceMusic":music.lastPathComponent,@"sourceChart":chart.lastPathComponent} mutableCopy];[db[@"songs"] addObject:song];[found[@"songs"] addObject:identifier];ok=[self commit:db error:error];return ok;
 }catch(const std::exception&e){if(error)*error=err([NSString stringWithUTF8String:e.what()]);return NO;}catch(...){if(error)*error=err(@"导入失败");return NO;}}@catch(NSException*exception){if(error)*error=err(exception.reason);return NO;}@finally{if(access)[url stopAccessingSecurityScopedResource];if(!ok)for(NSString*p in moved)[f removeItemAtPath:p error:nil];[f removeItemAtPath:stage error:nil];}
}

- (BOOL)removeSongs:(NSArray<NSString*>*)identifiers error:(NSError**)error{NSMutableSet*wanted=[NSMutableSet new];for(NSString*identifier in identifiers){if(!safeID(identifier)){if(error)*error=err(@"Invalid chart ID in batch");return NO;}[wanted addObject:identifier];}if(!wanted.count)return YES;NSMutableDictionary*db=clone([self snapshot]);NSMutableArray*songs=db[@"songs"];for(NSInteger i=songs.count-1;i>=0;--i)if([wanted containsObject:songs[i][@"id"]])[songs removeObjectAtIndex:i];for(NSMutableDictionary*c in db[@"chapters"])for(NSString*identifier in wanted)[c[@"songs"] removeObject:identifier];if(![self commit:db error:error])return NO;NSFileManager*f=NSFileManager.defaultManager;for(NSString*identifier in wanted){NSString*source=[self asset:identifier],*target=[[self.root stringByAppendingPathComponent:@"trash"]stringByAppendingPathComponent:[identifier stringByAppendingFormat:@"-%@",NSUUID.UUID.UUIDString]];if([f fileExistsAtPath:source])[f moveItemAtPath:source toPath:target error:nil];}return YES;}
- (NSURL*)exportSong:(NSString*)identifier error:(NSError**)error{NSDictionary*song=nil;for(NSDictionary*s in [self snapshot][@"songs"])if([s[@"id"] isEqualToString:identifier])song=s;if(!song){if(error)*error=err(@"谱面不存在");return nil;}NSString*folder=[self asset:identifier];NSDictionary*info=@{@"name":song[@"title"] ?: @"",@"composer":song[@"composer"] ?: @"",@"charter":song[@"charter"] ?: @"",@"illustrator":song[@"illustrator"] ?: @"",@"level":[NSString stringWithFormat:@"%@ %@",song[@"level"],song[@"difficulty"]],@"chart":@"chart.json",@"song":@"music.caf",@"picture":@"image.png"};if(!writeJSON(info,[folder stringByAppendingPathComponent:@"info.json"],error))return nil;NSString*out=[[self.root stringByAppendingPathComponent:@"exports"]stringByAppendingPathComponent:[identifier stringByAppendingString:@".zip"]];return PMCreateArchive(folder,out,error)?[NSURL fileURLWithPath:out]:nil;}
- (NSURL*)exportChapter:(NSString*)identifier error:(NSError**)error{NSDictionary*db=[self snapshot],*chapter=nil;for(NSDictionary*c in db[@"chapters"])if([c[@"id"] isEqualToString:identifier])chapter=c;if(!chapter){if(error)*error=err(@"只能导出自建章节");return nil;}NSFileManager*f=NSFileManager.defaultManager;NSString*stage=[[self.root stringByAppendingPathComponent:@"imports"]stringByAppendingPathComponent:NSUUID.UUID.UUIDString];[f createDirectoryAtPath:stage withIntermediateDirectories:YES attributes:nil error:error];NSMutableArray*songs=[NSMutableArray new];NSMutableDictionary*inventory=[NSMutableDictionary new];NSURL*result=nil;@try{for(NSDictionary*s in db[@"songs"])if([chapter[@"songs"] containsObject:s[@"id"]]||[s[@"targetChapter"] isEqualToString:identifier]){[songs addObject:s];NSString*dest=[[stage stringByAppendingPathComponent:@"songs"]stringByAppendingPathComponent:s[@"id"]];[f createDirectoryAtPath:dest.stringByDeletingLastPathComponent withIntermediateDirectories:YES attributes:nil error:nil];if(![f copyItemAtPath:[self asset:s[@"id"]] toPath:dest error:error])return nil;}NSString*cover=[[self asset:identifier]stringByAppendingPathComponent:@"image.png"];if([f fileExistsAtPath:cover]){[f createDirectoryAtPath:[stage stringByAppendingPathComponent:@"chapter"] withIntermediateDirectories:YES attributes:nil error:nil];[f copyItemAtPath:cover toPath:[stage stringByAppendingPathComponent:@"chapter/image.png"] error:nil];}for(NSString*name in [f subpathsOfDirectoryAtPath:stage error:nil]){NSString*p=[stage stringByAppendingPathComponent:name];BOOL directory=NO;[f fileExistsAtPath:p isDirectory:&directory];if(!directory)inventory[name]=@{@"size":[f attributesOfItemAtPath:p error:nil][NSFileSize],@"sha256":digest(p)};}NSDictionary*manifest=@{@"format":@"phigros-phi-chapter",@"version":@1,@"chapter":chapter,@"songs":songs,@"selections":db[@"chartSelections"] ?: @{},@"files":inventory};if(!writeJSON(manifest,[stage stringByAppendingPathComponent:@"chapter.json"],error))return nil;NSString*out=[[self.root stringByAppendingPathComponent:@"exports"]stringByAppendingPathComponent:[identifier stringByAppendingString:@".zip"]];if(PMCreateArchive(stage,out,error))result=[NSURL fileURLWithPath:out];return result;}@finally{[f removeItemAtPath:stage error:nil];}}
- (BOOL)removeSong:(NSString*)identifier error:(NSError**)error{NSMutableDictionary*db=clone([self snapshot]);NSMutableArray*songs=db[@"songs"];for(NSInteger i=songs.count-1;i>=0;--i)if([songs[i][@"id"] isEqualToString:identifier])[songs removeObjectAtIndex:i];for(NSMutableDictionary*c in db[@"chapters"])[c[@"songs"] removeObject:identifier];if(![self commit:db error:error])return NO;NSString*source=[self asset:identifier],*target=[[self.root stringByAppendingPathComponent:@"trash"]stringByAppendingPathComponent:[identifier stringByAppendingFormat:@"-%@",NSUUID.UUID.UUIDString]];if([NSFileManager.defaultManager fileExistsAtPath:source])[NSFileManager.defaultManager moveItemAtPath:source toPath:target error:nil];return YES;}
@end
